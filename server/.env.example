# Copy this file to .env and set your real Groq API key.
# The real key must NOT be committed to version control.
GROQ_API_KEY=

# AI model used for chat and lead extraction (Groq).
GROQ_MODEL=openai/gpt-oss-120b

# Secret used to sign admin session tokens. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Allowed origin for the admin dashboard (CORS). Widget is same-origin.
CLIENT_ORIGIN=http://localhost:5173

# Admin session lifetime in hours (default 12).
ADMIN_TOKEN_TTL=12
